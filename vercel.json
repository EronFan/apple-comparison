{
  "redirects": [
    {
      "source": "/src/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/src/:name.html",
      "destination": "/:name",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/src/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/public/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/public/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/public/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/public/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/src/index.html"
    },
    {
      "source": "/iphone-compare",
      "destination": "/src/iphone-compare.html"
    },
    {
      "source": "/ipad-compare",
      "destination": "/src/ipad-compare.html"
    },
    {
      "source": "/watch-compare",
      "destination": "/src/watch-compare.html"
    },
    {
      "source": "/mac-compare",
      "destination": "/src/mac-compare.html"
    },
    {
      "source": "/airpods-compare",
      "destination": "/src/airpods-compare.html"
    },
    {
      "source": "/tv-compare",
      "destination": "/src/tv-compare.html"
    },
    {
      "source": "/vision-compare",
      "destination": "/src/vision-compare.html"
    },
    {
      "source": "/homepod-compare",
      "destination": "/src/homepod-compare.html"
    },
    {
      "source": "/ipod-compare",
      "destination": "/src/ipod-compare.html"
    },
    {
      "source": "/chip-compare",
      "destination": "/src/chip-compare.html"
    },
    {
      "source": "/benchmarks",
      "destination": "/src/benchmarks.html"
    },
    {
      "source": "/battery",
      "destination": "/src/battery.html"
    },
    {
      "source": "/support",
      "destination": "/src/support.html"
    },
    {
      "source": "/glossary",
      "destination": "/src/glossary.html"
    },
    {
      "source": "/privacy",
      "destination": "/public/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/public/terms.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/public/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/public/robots.txt"
    },
    {
      "source": "/feedback",
      "destination": "/src/feedback.html"
    }
  ]
}
